{
  "name": "@serwist/utils",
  "version": "9.5.11",
  "type": "module",
  "description": "This module contains utilities used by Serwist packages.",
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "serwist",
    "serwistjs",
    "service worker",
    "sw"
  ],
  "author": "DuCanhGH <ducanh2912.rusty@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/serwist/serwist",
  "bugs": "https://github.com/serwist/serwist/issues",
  "homepage": "https://serwist.pages.dev",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "node": {
      "*": [
        "./dist/index.node.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/index.node.d.mts",
      "default": "./dist/index.node.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && NODE_ENV=production tsdown",
    "dev": "tsdown --watch",
    "lint": "biome lint ./src",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/common-tags": "1.8.4",
    "browserslist": "4.28.2",
    "common-tags": "1.8.2",
    "kolorist": "1.8.0",
    "tsdown": "0.22.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "browserslist": ">=4",
    "common-tags": ">=1.0.0",
    "kolorist": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "browserslist": {
      "optional": true
    },
    "common-tags": {
      "optional": true
    },
    "kolorist": {
      "optional": true
    }
  }
}
